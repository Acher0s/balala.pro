# Copy to .env and fill in. Used by docker-compose.yml (and by `npm run dev` if you set DATABASE_URL).

# Public address of the site, no trailing slash. Discord redirects back to SITE_URL/api/auth/discord/callback
SITE_URL=https://guides.example.com

# Discord application (https://discord.com/developers/applications → OAuth2).
# Add the redirect URL above under "Redirects".
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Your Discord user id(s), comma separated. These accounts become admins when they sign in.
# (Discord: Settings → Advanced → Developer Mode, then right-click your name → Copy User ID)
ADMIN_DISCORD_IDS=

# Database password for the bundled Postgres container.
POSTGRES_PASSWORD=change-me

# Leave unset for local development: an embedded database is stored in .data/
# DATABASE_URL=postgres://user:password@localhost:5432/bmp_university
